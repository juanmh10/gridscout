# GridScout Environment Configuration

# Application Mode: local | live
APP_MODE=local
EXTERNAL_PROVIDERS=disabled
MARKETPLACE_SOURCE=fixture
BROWSER_WORKER_URL=http://host.docker.internal:8100

# Server Ports
PORT=8000
WEB_PORT=3000

# Database
DATABASE_URL=postgresql+psycopg://marketradar:marketradar@localhost:5432/marketradar
FIXTURE_VERSION=v1.0.0

# ----------------------------------------------------
# Vertex AI / Gemini Configuration
# ----------------------------------------------------
# Active model adapter: local | gemini | vertex
MODEL_GATEWAY=local
# Model authentication: gemini_api uses GEMINI_API_KEY; vertex uses ADC.
GENAI_AUTH_MODE=gemini_api
EMBEDDING_PROVIDER=local
RETRIEVER=pgvector

# Google Cloud / Vertex AI settings
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_DATA_STORE_ID=hardware-knowledge

# Vertex AI Models (Gemini 3.x series)
VERTEX_MODEL_EXTRACTION=gemini-3.5-flash-lite
VERTEX_MODEL_INVESTIGATION=gemini-3.7-flash
VERTEX_MODEL_PRO=gemini-3.1-pro
VERTEX_EMBEDDING_MODEL=text-embedding-004

# Alternatively, direct Gemini Developer API Key:
GEMINI_API_KEY=

# WSLg browser login (used by the root launcher in live mode)
OLX_LOGIN_HEADLESS=false
# The root gridscout.bat sets these for the WSL host browser worker.
# OLX_CDP_ENDPOINT=http://127.0.0.1:9222
# OLX_CHROME_BINARY=google-chrome
# OLX_CHROME_PROFILE_DIR=.cache/olx_browser_profile
# OLX_CHROME_LOG_FILE=.cache/gridscout-olx-chrome.log
